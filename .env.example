# Copy to `.env` for local development. All EXPO_PUBLIC_* values are embedded
# into the client bundle at build time and are safe to expose (Supabase anon
# key, RevenueCat *public* SDK keys, Sentry DSN).
#
# For EAS builds these come from the per-profile `env` blocks in eas.json
# (or EAS dashboard environment variables) — NOT from this file.

# Supabase (project ref in the URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project settings → API keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Sentry (optional — leave blank to disable client crash reporting)
EXPO_PUBLIC_SENTRY_DSN=

# Environment label surfaced to Sentry: development | staging | production
EXPO_PUBLIC_ENV=development
